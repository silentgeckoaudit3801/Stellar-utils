{
  "name": "stellar-utils",
  "version": "0.1.0",
  "description": "Useful utilities for Stellar blockchain development",
  "main": "src/index.js",
  "scripts": {
    "test": "jest",
    "test:coverage": "jest --coverage"
  },
  "keywords": [
    "stellar",
    "blockchain",
    "utils"
  ],
  "author": "",
  "license": "GPL-3.0",
  "devDependencies": {
    "jest": "^29.7.0"
  },
  "dependencies": {
    "stellar-sdk": "^11.0.1"
  },
  "jest": {
    "collectCoverage": true,
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "json-summary"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/**/*.test.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  }
}
